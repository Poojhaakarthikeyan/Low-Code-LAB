	reports
	{
		default list All_Events
		{
			displayName = "All Events"
			show all rows from Events    
			(
				Event_Name as "Event Name "
				Event_type as "Event type"
				Event_Date as "Event Date"
				Venue
				Capacity
				Budget
				Event_Status as "Event Status"
				Attendance_Rate as "Attendance Rate"
				Average_Feedback_Score as "Average Feedback Score"
				Total_Expenses as "Total Expenses"
				Budget_utilization
				Performance_Score
				Risk_Score
			)
		}
		default list All_Participants
		{
			displayName = "All Participants"
			show all rows from Participants    
			(
				name as "Participant Name"
				Email
				Department
				Year_of_Study as "Year of Study"
				Participants
				Registration_Date as "Registration Date"
				Attendance_Status as "Attendance Status"
