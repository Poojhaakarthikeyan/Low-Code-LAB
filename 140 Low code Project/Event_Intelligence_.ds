 application "Event Intelligence "
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Event_Expenses
		{
			displayname = "Event Expenses"
			success message = "Event Expense Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Events
			(
				type = picklist	
				values  = Events.ID
    			displayformat = [Event_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Expense_Category
			(
				type = picklist
				displayname = "Expense Category"
				maxchar = 100
				values = {"Venue","Food","Marketing","Equipment","Transport","Prizes"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Total_Expenses
			(
				displayname = "Total Expenses"
				type = INR
				format = commadotindian
				initial value = 0
				decimalplace = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Expense_Date
			(
    			type = date
				displayname = "Expense Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Description
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Amount
			(
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Events
		{
			success message = "Event Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
