				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Event_Name
			(
    			type = text
				displayname = "Event Name "
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Event_Date
			(
    			type = date
				displayname = "Event Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Venue
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Capacity
