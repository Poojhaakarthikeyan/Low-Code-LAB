	pages
	{
		page Event_Intelligence_Dashboard
		{
			displayname = "Event Intelligence Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t\n</layout>\n</zml>"
		}
		page Event_Intelligence_Dashboard1
		{
			displayname = "Event Intelligence Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<gauge \n\telementName='Gauge'\n\n\tcolor = '#8A3DFB'\n\tsize = '20px'\n\tfontFamily = 'default' \n\tbgColor = '#FFFFFF'\n\ttheme = '#2A70E7'\n\tdisplayType = 'actual'\n\ttype = '1'\n\tfilledColor = '#2A70E7'\n\tnonFilledColor = '#F5F5F5'\n\tneedleColor = '#000000'\n\ttargetColor = '#D8D8D8'\n\tvalue = 'thisapp.Events.Average_Feedback_Score.avg'\n>\n<target size=\"15px\" color=\"#FF0048\" fontFamily=\"default\" value=\"\"\n/><maximumvalue size=\"15px\" color=\"#2A70E7\" value=\"5\" \n/>\n</gauge>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<gauge \n\telementName='Gauge 1'\n\n\tcolor = '#06943F'\n\tsize = '20px'\n\tfontFamily = 'default' \n\tbgColor = '#FFFFFF'\n\ttheme = '#FF3B2C'\n\tdisplayType = 'actual'\n\ttype = '1'\n\tfilledColor = '#FF3B2C'\n\tnonFilledColor = '#F5F5F5'\n\tneedleColor = '#000000'\n\ttargetColor = '#D8D8D8'\n\tvalue = 'thisapp.Events.Budget_utilization.avg'\n>\n<target size=\"15px\" color=\"#FF8318\" fontFamily=\"default\" value=\"\"\n/><maximumvalue size=\"15px\" color=\"#59DDBB\" value=\"100\" \n/>\n</gauge>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<gauge \n\telementName='Gauge 2'\n\n\tcolor = '#951FB8'\n\tsize = '20px'\n\tfontFamily = 'default' \n\tbgColor = '#FFFFFF'\n\ttheme = '#38D66D'\n\tdisplayType = 'actual'\n\ttype = '1'\n\tfilledColor = '#38D66D'\n\tnonFilledColor = '#F5F5F5'\n\tneedleColor = '#000000'\n\ttargetColor = '#D8D8D8'\n\tvalue = 'thisapp.Events.Attendance_Rate.avg'\n>\n<target size=\"15px\" color=\"#3F3F3F\" fontFamily=\"default\" value=\"\"\n/><maximumvalue size=\"15px\" color=\"#CB3B23\" value=\"100\" \n/>\n</gauge>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<gauge \n\telementName='Gauge 3'\n\n\tcolor = '#6D2FC8'\n\tsize = '20px'\n\tfontFamily = 'default' \n\tbgColor = '#FFFFFF'\n\ttheme = '#1996E8'\n\tdisplayType = 'actual'\n\ttype = '1'\n\tfilledColor = '#1996E8'\n\tnonFilledColor = '#F5F5F5'\n\tneedleColor = '#000000'\n\ttargetColor = '#D8D8D8'\n\tvalue = 'thisapp.Events.Performance_Score.avg'\n>\n<target size=\"15px\" color=\"#819BEC\" fontFamily=\"default\" value=\"\"\n/><maximumvalue size=\"15px\" color=\"#009074\" value=\"100\" \n/>\n</gauge>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<chart \n\telementName='Chart'\n\n\ttype = 'Column'\n\txtitle = 'Event Name '\n\tytitle = 'Total Expenses'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Events'\n\txfield = 'Event_Name'\n\tyfields = 'sum:Total_Expenses'\n/>\n\n</column>\n</row>\n</layout>\n</zml>"
		}
	}




		workflow
		{
		form
		{
			Calculate_Attendance as "Calculate Attendance"
			{
				type =  form
				form = Participants

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Count all participants registered for this event
										registered_count = Participants[Participants == input.Participants].count();
										// Count participants who attended
										attended_count = Participants[Participants == input.Participants && Attendance_Status == "Attended"].count();
										// Calculate attendance percentage
										if(registered_count > 0)
										{
											attendance_rate = attended_count.toDecimal() / registered_count.toDecimal() * 100;
										}
										else
										{
											attendance_rate = 0;
										}
										// Update the corresponding Event
										for each  event_record in Events[ID == input.Participants]
										{
											event_record.Attendance_Rate=attendance_rate;
										}
						)
					}
				}

			}
			Update_Attendance as "Update Attendance"
			{
				type =  form
				form = Participants

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											registered_count = Participants[Participants == input.Participants].count();
										attended_count = Participants[Participants == input.Participants && Attendance_Status == "Attended"].count();
										if(registered_count > 0)
										{
											attendance_rate = attended_count.toDecimal() / registered_count.toDecimal() * 100;
										}
										else
										{
											attendance_rate = 0;
										}
										for each  event_record in Events[ID == input.Participants]
										{
											event_record.Attendance_Rate=attendance_rate;
										}
						)
					}
				}

			}
			Update_Attendance_after_e as "Update Attendance after editing"
			{
				type =  form
				form = Participants

				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											registered_count = Participants[Participants == input.Participants].count();
										attended_count = Participants[Participants == input.Participants && Attendance_Status == "Attended"].count();
										if(registered_count > 0)
										{
											attendance_rate = attended_count.toDecimal() / registered_count.toDecimal() * 100;
										}
										else
										{
											attendance_rate = 0;
										}
										for each  event_record in Events[ID == input.Participants]
										{
											event_record.Attendance_Rate=attendance_rate;
										}
						)
					}
				}

			}
			Calculate_Feedback_Score as "Calculate Feedback Score"
			{
				type =  form
				form = Feedback

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											feedback_count = Feedback[Events == input.Events].count();
										event_id = input.Events.get(0);
										feedback_records = Feedback[Events == event_id];
										feedback_count = feedback_records.count();
										average_rating = 0;
										if(feedback_count > 0)
										{
											total_rating = 0;
											for each  feedback_record in feedback_records
											{
												total_rating = total_rating + ifnull(feedback_record.Overall_Rating,0);
											}
											average_rating = total_rating.toDecimal() / feedback_count.toDecimal();
										}
										for each  event_record in Events[ID == event_id]
										{
											event_record.Average_Feedback_Score=average_rating;
										}
						)
					}
				}

			}
			Calculate_Total_Expenses as "Calculate Total Expenses"
			{
				type =  form
				form = Event_Expenses

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											event_id = input.Events;
										total_expenses = 0;
										for each  expense_record in Event_Expenses[Events == event_id]
										{
											total_expenses = total_expenses + ifnull(expense_record.Amount,0);
										}
										for each  event_record in Events[ID == event_id]
										{
											event_record.Total_Expenses=total_expenses;
										}
						)
					}
				}

			}
			Calculate_Event_Intellige as "Calculate Event Intelligence"
			{
				type =  form
				form = Events

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Get current event values
										budget = ifnull(input.Budget,0);
										expenses = ifnull(input.Total_Expenses,0);
										attendance = ifnull(input.Attendance_Rate,0);
										feedback = ifnull(input.Average_Feedback_Score,0);
										// Calculate Budget Utilization
										budget_utilization = 0;
										if(budget > 0)
										{
											budget_utilization = expenses.toDecimal() / budget.toDecimal() * 100;
										}
										// Calculate Performance Score
										performance_score = attendance.toDecimal() * 0.5 + feedback.toDecimal() / 5 * 100 * 0.5;
										// Calculate Risk Score
										risk_score = 0;
										if(budget_utilization > 90)
										{
											risk_score = risk_score + 40;
										}
										else if(budget_utilization > 75)
										{
											risk_score = risk_score + 20;
										}
										if(attendance < 50)
										{
											risk_score = risk_score + 30;
										}
										else if(attendance < 70)
										{
											risk_score = risk_score + 15;
										}
										if(feedback < 3)
										{
											risk_score = risk_score + 30;
										}
										else if(feedback < 4)
										{
											risk_score = risk_score + 15;
										}
										// Update intelligence fields
										input.Budget_utilization = budget_utilization;
										input.Performance_Score = performance_score;
										input.Risk_Score = risk_score;
						)
					}
				}

			}
			Calculate_Attendance_Rate as "Calculate Attendance Rate"
			{
				type =  form
				form = Participants

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											event_id = input.Events;
										registered_count = Participants[Events == event_id].count();
										attended_count = Participants[Events == event_id && Attendance_Status == "Attended"].count();
										attendance_rate = 0;
										if(registered_count > 0)
										{
											attendance_rate = attended_count.toDecimal() / registered_count.toDecimal() * 100;
										}
										for each  event_record in Events[ID == event_id]
										{
											event_record.Attendance_Rate=attendance_rate;
										}
						)
					}
				}

			}
		}






	}
	share_settings
	{
			"Read"
			{
				name = "Read"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
