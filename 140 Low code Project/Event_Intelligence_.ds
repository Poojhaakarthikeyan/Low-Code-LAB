			)
			Year_of_Study
			(
				type = picklist
				displayname = "Year of Study"
				maxchar = 100
				values = {"2","3","4"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Participants
			(
				type = list	
				values  = Participants.ID
    			displayformat = [name]
				advanced field search = true
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Registration_Date
			(
    			type = date
				displayname = "Registration Date"
				initial value = "20-Oct-2026"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Attendance_Status
			(
				type = picklist
				displayname = "Attendance Status"
				maxchar = 100
